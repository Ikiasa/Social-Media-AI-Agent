# Riona Social Media AI Agent - Environment Configuration Template
# DO NOT COMMIT REAL CREDENTIALS, SECRETS, OR TOKENS TO THIS FILE OR SOURCE CONTROL.

NODE_ENV=development
PORT=3001

# Database & Cache Connection Strings (Must be isolated per environment)
DATABASE_URL=mongodb://localhost:27017/riona_dev
REDIS_URL=redis://localhost:6379

# Object Storage Bucket (Must be isolated per environment)
STORAGE_BUCKET=riona-dev-assets

# OAuth & Webhook Endpoints (Must use environment-specific callback domain)
OAUTH_CALLBACK_URL=https://api-dev.riona.ai/api/v1/oauth/callback
WEBHOOK_BASE_URL=https://api-dev.riona.ai/api/v1/social-data/webhooks

# Application Security Secrets (Must be injected from Secret Manager in Staging/Production)
WEBHOOK_SECRET=
HMAC_APPROVAL_SECRET=
JWT_SECRET=
SIGNED_URL_SECRET=

# Official Provider OAuth Application Credentials (Pilot: Instagram Official API)
INSTAGRAM_CLIENT_ID=
INSTAGRAM_CLIENT_SECRET=
